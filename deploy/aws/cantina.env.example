# /etc/cantina/cantina.env — permessi 600, proprietario root (systemd lo legge prima di cambiare utente).
# Copiare i valori dalle Variables del servizio Railway "cantina-booking".

NODE_ENV=production
PORT=3000
# Il server ascolta su localhost: lo raggiunge solo Caddy.
TRUST_PROXY=loopback
# Disco EBS: database, uploads/, catalogs/, hr-files/, fair-attachments/, crm-attachments/, backups/
DATA_DIR=/data

CANTINA_NAME="Marramiero"
ADMIN_PASSWORD=
# OBBLIGATORIA e IDENTICA a quella su Railway: i documenti HR copiati sono cifrati con questa chiave.
HR_FILES_KEY=
# Se su Railway è impostata, riportarla uguale (altrimenti i link firmati già inviati smettono di funzionare).
SIGNING_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GMAIL_USER=
GMAIL_PASS=
RESEND_API_KEY=
RESEND_FROM=
